"""Types for the part of pyrage 1.4.0 that Atlas uses. pyrage ships no type information."""

from pyrage import x25519 as x25519

class DecryptError(Exception): ...
class EncryptError(Exception): ...
class IdentityError(Exception): ...
class RecipientError(Exception): ...

def encrypt(
    plaintext: bytes, recipients: list[x25519.Recipient], armored: bool = False
) -> bytes: ...
def decrypt(ciphertext: bytes, identities: list[x25519.Identity]) -> bytes: ...
