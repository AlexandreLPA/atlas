"""Types for the part of croniter 6.0.0 that Atlas uses. It ships no type information."""

from datetime import datetime

class croniter:  # noqa: N801
    def __init__(self, expr_format: str, start_time: datetime | None = None) -> None: ...
    def get_next(self, ret_type: type[datetime]) -> datetime: ...
    @classmethod
    def is_valid(cls, expression: str) -> bool: ...

class CroniterError(ValueError): ...
