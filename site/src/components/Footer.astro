---
import { REPOSITORY } from '../../site.config.mjs'
import Mark from '../assets/atlas-mark.svg'

const columns = [
  {
    title: 'Atlas',
    links: [
      { href: '/#install', label: 'Install' },
      { href: '/docs/', label: 'Documentation' },
      { href: '/changelog/', label: 'Changelog' },
      { href: '/news/', label: 'News' }
    ]
  },
  {
    title: 'Guides',
    links: [
      { href: '/docs/guides/coding-agents/', label: 'Coding agents and accounts' },
      { href: '/docs/guides/machines/', label: 'Several machines' },
      { href: '/docs/guides/models/', label: 'Models and keys' },
      { href: '/docs/troubleshooting/', label: 'Troubleshooting' }
    ]
  },
  {
    title: 'Open source',
    links: [
      { href: REPOSITORY, label: 'GitHub' },
      { href: `${REPOSITORY}/issues`, label: 'Issues' },
      { href: '/docs/extending/plugins/', label: 'Write a plugin' },
      { href: `${REPOSITORY}/blob/main/LICENSE`, label: 'MIT license' }
    ]
  },
  {
    title: 'For agents',
    links: [
      { href: '/llms.txt', label: 'llms.txt' },
      { href: '/llms-full.txt', label: 'llms-full.txt' },
      { href: '/index.md', label: 'This site in Markdown' },
      { href: '/changelog/rss.xml', label: 'Changelog feed' }
    ]
  }
]
---

<footer class="footer">
  <div class="page wordmark" data-wordmark="Atlas">
    <canvas aria-hidden="true"></canvas>
    <p class="visually-hidden">Atlas</p>
  </div>
  <div class="page footer-grid">
    <div class="footer-brand">
      <a class="footer-home" href="/" aria-label="Atlas, home">
        <Mark class="footer-mark" aria-hidden="true" />
      </a>
      <p class="footer-line">Every coding agent. Every account. One window.</p>
      <p>
        Free and open source under the MIT license. No account, no telemetry: what Atlas learns stays on your machine.
      </p>
      <a class="button button--solid footer-install" href="/#install">
        Install Atlas
      </a>
    </div>
    <nav class="footer-links" aria-label="Footer">
      {columns.map(column => (
        <div>
          <p class="footer-title">{column.title}</p>
          <ul>
            {column.links.map(link => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="page footer-base">
    <p>Atlas is not affiliated with Anthropic, OpenAI, Google or DeepSeek. Their products’ names belong to them.</p>
    <p>Set in Mona Sans and Martian Mono, under the SIL Open Font License.</p>
  </div>
</footer>

<style>
  .wordmark {
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .wordmark canvas {
    width: 100%;
    min-height: 6rem;
  }

  .footer {
    position: relative;
    padding: 5.5rem 0 2.5rem;
    border-top: 1px solid var(--rule);
    background: var(--night);
    color: var(--haze);
    font-size: var(--step--1);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(3rem, 6vw, 6rem);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
    max-width: 22rem;
  }

  .footer-home {
    color: var(--starlight);
  }

  .footer-mark {
    width: 2.75rem;
    height: 2.75rem;
  }

  .footer-line {
    color: var(--starlight);
    font-size: var(--step-1);
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .footer-install {
    margin-top: 0.5rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-title {
    margin-bottom: 1rem;
    color: var(--starlight);
    font-size: var(--step--2);
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-links ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--haze);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--starlight);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 4.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--2);
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
