---
import { getCollection } from 'astro:content'

import NewsPicture from '../../components/NewsPicture.astro'
import AsciiTitle from '../../components/AsciiTitle.astro'
import Site from '../../layouts/Site.astro'

const items = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const topics = new Map<string, number>()
for (const item of items) {
  for (const topic of item.data.topics) {
    topics.set(topic, (topics.get(topic) ?? 0) + 1)
  }
}
const tabs = Array.from(topics).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
const lede = (body: string | undefined) =>
  (body ?? '')
    .trim()
    .split(/\n\s*\n/)[0]
    ?.replace(/\s+/g, ' ') ?? ''
const description =
  'Short summaries, in our words, of what changes in the models and tools Atlas works with. Each one links to the full story where it was published.'
---

<Site
  title="Atlas news: what changes in coding agents and models"
  description={description}
  markdown="/news.md"
  current="news"
>
  <div class="listing">
    <header class="listing-head">
      <AsciiTitle word="News" />
      <div class="listing-intro">
        <p>{description}</p>
        <a class="feed" href="/news/rss.xml">
          Follow the feed
        </a>
      </div>
    </header>
    {items.length === 0 ? (
      <section class="empty">
        <h2>The first summaries are on the way</h2>
        <p>
          Until they arrive, the <a href="/changelog/">changelog</a> lists every change to Atlas itself, and the{' '}
          <a href="/news/rss.xml">feed</a> brings the first summaries to your reader as soon as they are out.
        </p>
      </section>
    ) : (
      <div data-news>
        <div class="tools reveal">
          <div class="tabs" role="group" aria-label="Topics">
            <button type="button" data-news-tab="" aria-pressed="true">
              Latest <span class="count">{items.length}</span>
            </button>
            {tabs.map(([topic, count]) => (
              <button type="button" data-news-tab={topic} aria-pressed="false">
                {topic} <span class="count">{count}</span>
              </button>
            ))}
          </div>
          <label class="search">
            <span class="visually-hidden">Search the news</span>
            <input type="search" placeholder="Search news" data-news-search autocomplete="off" />
          </label>
        </div>
        <ol class="rows">
          {items.map((item, index) => (
            <li
              class="reveal"
              data-news-row
              data-topics={item.data.topics.join(' ')}
              data-text={`${item.data.title} ${item.data.source} ${item.data.topics.join(' ')}`.toLowerCase()}
              style={`--n: '${String(index + 1).padStart(2, '0')}'`}
            >
              <a class="row" href={`/news/${item.id}/`}>
                <span class="num" aria-hidden="true" />
                <span class="thumb-frame">
                  <NewsPicture image={item.data.image} seed={item.data.title} />
                </span>
                <span class="head">
                  <span class="meta">
                    <span class="kind">{item.data.kind}</span>
                    <span>{item.data.source}</span>
                    <time datetime={item.data.date.toISOString().slice(0, 10)}>
                      {item.data.date.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        timeZone: 'UTC'
                      })}
                    </time>
                  </span>
                  <span class="title">{item.data.title}</span>
                  <span class="lede">{lede(item.body)}</span>
                  <span class="more" aria-hidden="true">
                    Read more →
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="none" data-news-empty hidden>
          No stories match these filters.
        </p>
        <p class="credit">Stories are indexed from AlphaSignal. Rights remain with the original publisher.</p>
      </div>
    )}
  </div>
</Site>

<script>
  import '../../scripts/news-filter'
</script>

<style>
  .listing {
    width: min(100% - 2 * var(--gutter), 90rem);
    margin-inline: auto;
    padding: 11rem 0 8rem;
  }

  .listing-head {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 6rem;
  }

  .listing-intro {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-bottom: 0.6rem;
  }

  .listing-intro p {
    max-width: 30rem;
    color: rgb(var(--fg-rgb) / 0.86);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .feed {
    color: var(--brass);
    font-size: var(--step--1);
  }

  .empty {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }

  .empty h2 {
    font-size: var(--step-2);
  }

  .empty p {
    color: var(--haze);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 2rem;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tabs button {
    padding: 0.55rem 1.1rem;
    border: 0;
    border-radius: 0;
    background: rgb(var(--fg-rgb) / 0.06);
    color: rgb(var(--fg-rgb) / 0.78);
    font: inherit;
    font-size: var(--step--1);
    text-transform: capitalize;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .tabs button:hover {
    background: rgb(var(--fg-rgb) / 0.12);
    color: var(--starlight);
  }

  .tabs button[aria-pressed='true'] {
    background: var(--brass);
    color: var(--night);
    font-weight: 600;
  }

  .count {
    margin-left: 0.35em;
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
  }

  .search input {
    width: min(100%, 20rem);
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 0;
    background: rgb(var(--fg-rgb) / 0.06);
    color: var(--starlight);
    font: inherit;
    font-size: var(--step--1);
    transition: background 0.2s;
  }

  .search input::placeholder {
    color: var(--haze);
  }

  .search input:focus-visible {
    background: rgb(var(--fg-rgb) / 0.12);
  }

  .rows {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 26rem) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding: 1.5rem 1.5rem 1.5rem 0.5rem;
    border-radius: 0;
    color: inherit;
    text-decoration: none;
    transition: background 0.25s;
  }

  .row:hover,
  .row:focus-visible {
    background: rgb(var(--fg-rgb) / 0.04);
  }

  .num::before {
    content: var(--n);
    color: rgb(var(--fg-rgb) / 0.28);
    font-size: var(--step-4);
    font-stretch: var(--wide);
    font-weight: 700;
    letter-spacing: -0.04em;
    transition: color 0.25s;
  }

  .row:hover .num::before,
  .row:focus-visible .num::before {
    color: var(--brass);
  }

  .thumb-frame {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0;
    background: var(--night-lift);
  }

  .thumb-frame :global(img),
  .thumb-frame :global(svg) {
    transition: transform 0.6s var(--ease-out);
  }

  .row:hover .thumb-frame :global(img),
  .row:hover .thumb-frame :global(svg) {
    transform: scale(1.04);
  }

  .head {
    display: grid;
    gap: 0.85rem;
    max-width: 46rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    color: var(--haze);
    font-size: var(--step--1);
  }

  .kind {
    padding: 0.1rem 0.7rem;
    border-radius: 0;
    background: var(--brass-soft);
    color: var(--brass);
    font-weight: 600;
    text-transform: capitalize;
  }

  .title {
    font-size: var(--step-3);
    font-weight: 620;
    font-stretch: var(--wide);
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .lede {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(var(--fg-rgb) / 0.76);
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .more {
    color: var(--brass);
    font-size: var(--step--1);
    font-weight: 600;
    transition: transform 0.25s var(--ease-out);
  }

  .row:hover .more {
    transform: translateX(4px);
  }

  .none {
    padding: 4rem 0;
    color: var(--haze);
  }

  .credit {
    margin-top: 3rem;
    color: var(--haze);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb-frame :global(img),
    .thumb-frame :global(svg),
    .more {
      transition: none;
    }

    .row:hover .thumb-frame :global(img),
    .row:hover .thumb-frame :global(svg),
    .row:hover .more {
      transform: none;
    }
  }

  @media (max-width: 1100px) {
    .row {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 1.75rem;
    }

    .num {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .listing {
      padding-top: 8rem;
    }

    .listing-head {
      grid-template-columns: 1fr;
      margin-bottom: 3.5rem;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 1rem 0 1.75rem;
    }
  }

  /* The grid: hairline borders, square corners, the labels of a terminal. */
  .tabs {
    gap: 0;
  }

  .tabs button {
    margin-left: -1px;
    padding: 0.7rem 1rem;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--haze);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tabs button:hover {
    background: rgb(var(--fg-rgb) / 0.06);
    color: var(--starlight);
  }

  .tabs button[aria-pressed='true'] {
    border-color: var(--starlight);
    background: var(--starlight);
    color: var(--night);
    font-weight: 600;
  }

  .search input {
    border: 1px solid var(--rule);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search input:focus-visible {
    border-color: var(--brass);
    background: transparent;
  }

  .rows {
    gap: 0;
    border: 1px solid var(--rule);
    border-bottom: 0;
  }

  .rows li {
    border-bottom: 1px solid var(--rule);
  }

  .row {
    padding: 1.75rem;
  }

  .row:hover,
  .row:focus-visible {
    background: rgb(var(--fg-rgb) / 0.04);
  }

  .num::before {
    color: rgb(var(--fg-rgb) / 0.32);
  }

  .thumb-frame {
    border: 1px solid var(--rule);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kind {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--starlight);
    font-weight: 500;
  }

  .more {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .feed {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
